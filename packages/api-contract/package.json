{
  "name": "@inno-trec/api-contract",
  "version": "0.1.0",
  "private": true,
  "description": "Draft OpenAPI contract between INNO-TREC data providers (WP2) and the web tools, with TypeScript types generated from it.",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./openapi.yaml": "./openapi.yaml"
  },
  "scripts": {
    "types": "openapi-typescript openapi.yaml -o src/schema.d.ts",
    "lint": "redocly lint openapi.yaml"
  },
  "devDependencies": {
    "@redocly/cli": "2.60.0",
    "openapi-typescript": "^7.13.0"
  }
}
