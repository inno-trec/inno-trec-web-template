{
  "name": "@inno-trec/tokens",
  "version": "0.1.0",
  "private": true,
  "description": "INNO-TREC design tokens as a Tailwind preset (web and NativeWind), CSS variables and plain JS constants.",
  "main": "./dist/tokens.cjs",
  "types": "./dist/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.mjs",
      "default": "./dist/tokens.cjs"
    },
    "./tailwind-preset": "./dist/tailwind-preset.cjs",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./tokens.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "module": "./dist/tokens.mjs"
}
